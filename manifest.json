{
  "manifest_version": 3,
  "name": "Page Clipper",
  "version": "1.0.0",
  "description": "Clip the main article content from the current tab into a Tana-ready format.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy article to Tana"
  },
  "commands": {
    "clip-selection": {
      "description": "Copy the main article on the active tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "readability.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
