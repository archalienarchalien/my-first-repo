{
  "manifest_version": 3,
  "name": "Article Extractor",
  "version": "1.0.0",
  "description": "Extracts article information when the extension action is clicked.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Extract article details"
  }
}
